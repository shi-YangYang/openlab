# LLM (OpenAI-compatible API) configuration.
# Copy this file to `.env` and fill in your values. Do NOT commit `.env`.
# These act as fallbacks: values saved via the UI (GET/PUT /api/llm/config)
# are persisted to `data/llm_config.json` and take precedence over env vars.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: override the local LLM config file path (default data/llm_config.json).
# LLM_CONFIG_PATH=data/llm_config.json

# Common OpenAI-compatible base URLs:
#   OpenAI              https://api.openai.com/v1
#   DeepSeek            https://api.deepseek.com/v1
#   阿里云百炼 DashScope  https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动 SiliconFlow  https://api.siliconflow.cn/v1
#   智谱 GLM            https://open.bigmodel.cn/api/paas/v4
#   Moonshot Kimi       https://api.moonshot.cn/v1

# Storage (relative paths are resolved against the backend directory).
# DATA_DIR=data
# PAPERS_DIR=data/papers
# DB_PATH=data/openlab.db

# arXiv API rate limiting / retry.
ARXIV_REQUEST_INTERVAL=3.0
ARXIV_MAX_RETRIES=3

# Semantic Scholar Graph API (optional).
# Leave empty to use the unauthenticated shared quota; transient 429 rate limits
# are retried automatically. A free API key raises the official quota, apply at:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Outbound proxy for external HTTP (search / PDF download). Optional.
# Leave empty for direct connections. Set this when direct access to
# arxiv.org / semanticscholar.org is blocked or reset by the network.
# Note: httpx does NOT read Windows system proxy settings automatically, so if
# your machine needs a proxy (e.g. Clash on 127.0.0.1:7897), configure it here:
# HTTP_PROXY_OVERRIDE=http://127.0.0.1:7897
